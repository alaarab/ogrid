{
  "name": "@alaarab/ogrid-angular-radix",
  "version": "2.0.16",
  "description": "OGrid Angular Radix – Lightweight data grid with sorting, filtering, pagination, column chooser, and CSV export. Built with Angular CDK.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "keywords": [
    "ogrid",
    "datagrid",
    "angular",
    "angular-cdk",
    "data-table",
    "spreadsheet",
    "grid"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaarab/ogrid.git",
    "directory": "packages/angular-radix"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/compile-styles.js",
    "test": "jest",
    "storybook": "ng run angular-radix:storybook",
    "build-storybook": "ng run angular-radix:build-storybook"
  },
  "dependencies": {
    "@alaarab/ogrid-angular": "2.0.15",
    "@angular/cdk": "^21.0.0"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0",
    "@angular/common": "^21.0.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "rimraf": "^5.0.0",
    "sass": "^1.97.3",
    "typescript": "^5.9.3",
    "@angular/core": "^21.1.4",
    "@angular/common": "^21.1.4",
    "@angular/compiler": "^21.1.4",
    "@angular/platform-browser": "^21.1.4",
    "@angular/platform-browser-dynamic": "^21.1.4",
    "@angular/animations": "^21.1.4",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.4",
    "@angular-devkit/core": "^21.1.4",
    "@angular-devkit/architect": "^0.2101.4",
    "@angular-devkit/build-angular": "^21.1.4",
    "@storybook/angular": "^10.2.8",
    "storybook": "^10.2.8",
    "rxjs": "^7.8.2",
    "zone.js": "^0.15.0"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
