{
  "name": "@alaarab/ogrid-vue-radix",
  "version": "2.1.15",
  "description": "OGrid Vue Radix – Lightweight data grid with sorting, filtering, pagination, column chooser, and CSV export. Built with Headless UI Vue.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./styles/*": "./dist/esm/*"
  },
  "scripts": {
    "build": "rimraf dist && vite build && node scripts/compile-styles.js",
    "test": "jest",
    "storybook": "storybook dev -p 6014 --no-open",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "ogrid",
    "headlessui",
    "vue",
    "datatable",
    "typescript",
    "grid",
    "headless"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alaarab/ogrid-vue": "2.1.15",
    "@headlessui/vue": "^1.7.23"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "^10.2.8",
    "@types/jest": "^30.0.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "jest-environment-jsdom": "^30.2.0",
    "sass": "^1.97.3",
    "storybook": "^10.2.8",
    "ts-jest": "^29.4.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.28"
  },
  "publishConfig": {
    "access": "public"
  },
  "_buildNote": "Uses Vite (not tsc) because this package includes Vue SFC (.vue) files that require @vitejs/plugin-vue for compilation. Other vue-* packages that use only .ts files could use tsc.",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaarab/ogrid.git",
    "directory": "packages/vue-radix"
  },
  "homepage": "https://ogrid.dev",
  "bugs": "https://github.com/alaarab/ogrid/issues"
}
