{
  "name": "@alaarab/ogrid-vue-radix",
  "version": "2.0.22",
  "description": "OGrid Vue Radix – Lightweight data grid with sorting, filtering, pagination, column chooser, and CSV export. Built with Headless UI Vue.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && vite build && node scripts/compile-styles.js",
    "test": "jest",
    "storybook": "storybook dev -p 6014 --no-open",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "ogrid",
    "headlessui",
    "vue",
    "datatable",
    "typescript",
    "grid",
    "headless"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alaarab/ogrid-vue": "2.0.22",
    "@headlessui/vue": "^1.7.23"
  },
  "peerDependencies": {
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "vue": "^3.5.28",
    "@vitejs/plugin-vue": "^6.0.4",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "typescript": "^5.9.3",
    "sass": "^1.97.3",
    "@types/jest": "^29.5.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "ts-jest": "^29.4.6",
    "@storybook/vue3-vite": "^10.2.8",
    "storybook": "^10.2.8"
  },
  "publishConfig": {
    "access": "public"
  }
}
