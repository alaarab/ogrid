{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "angular-primeng": {
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angular-primeng:build-storybook",
            "port": 6010,
            "compodoc": false,
            "tsConfig": "tsconfig.storybook.json"
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "compodoc": false,
            "tsConfig": "tsconfig.storybook.json"
          }
        }
      }
    }
  }
}
