{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "projects": {
    "angular-primeng": {
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:browser",
          "options": {
            "tsConfig": "tsconfig.storybook.json",
            "main": ".storybook/storybook-entry.ts",
            "index": ".storybook/index.html",
            "outputPath": "dist/storybook-build"
          }
        },
        "storybook": {
          "builder": "@storybook/angular:start-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angular-primeng:build",
            "tsConfig": "tsconfig.storybook.json",
            "port": 6010,
            "compodoc": false
          }
        },
        "build-storybook": {
          "builder": "@storybook/angular:build-storybook",
          "options": {
            "configDir": ".storybook",
            "browserTarget": "angular-primeng:build",
            "tsConfig": "tsconfig.storybook.json",
            "compodoc": false
          }
        }
      }
    }
  },
  "cli": {
    "analytics": "65c5aa39-3ad7-411f-a97c-20b5652c8071"
  }
}
