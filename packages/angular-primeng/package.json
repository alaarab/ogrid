{
  "name": "@alaarab/ogrid-angular-primeng",
  "version": "2.7.2",
  "description": "OGrid PrimeNG – PrimeNG Table-based data grid with sorting, filtering, pagination, column chooser, and CSV export.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && ngc -p tsconfig.build.json",
    "test": "jest --passWithNoTests",
    "storybook": "ng run angular-primeng:storybook",
    "build-storybook": "ng run angular-primeng:build-storybook"
  },
  "keywords": [
    "ogrid",
    "angular",
    "primeng",
    "datatable",
    "typescript",
    "grid"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alaarab/ogrid-angular": "2.7.2"
  },
  "peerDependencies": {
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "primeng": "^21.0.0"
  },
  "devDependencies": {
    "@angular-devkit/architect": "^0.2102.5",
    "@angular-devkit/build-angular": "^21.2.5",
    "@angular-devkit/core": "^21.2.5",
    "@angular/animations": "^21.2.6",
    "@angular/cli": "^21.2.5",
    "@angular/common": "^21.2.6",
    "@angular/compiler": "^21.2.6",
    "@angular/compiler-cli": "^21.2.6",
    "@angular/core": "^21.2.6",
    "@angular/platform-browser": "^21.2.6",
    "@angular/platform-browser-dynamic": "^21.2.6",
    "@angular/router": "^21.2.6",
    "@storybook/angular": "^10.3.3",
    "primeng": "^21.1.4",
    "rxjs": "^7.8.2",
    "storybook": "^10.3.3",
    "typescript": "^6.0.0",
    "zone.js": "^0.16.0"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alaarab/ogrid.git",
    "directory": "packages/angular-primeng"
  },
  "homepage": "https://ogrid.dev",
  "bugs": "https://github.com/alaarab/ogrid/issues"
