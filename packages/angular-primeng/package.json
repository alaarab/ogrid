{
  "name": "@alaarab/ogrid-angular-primeng",
  "version": "2.1.5",
  "description": "OGrid PrimeNG – PrimeNG Table-based data grid with sorting, filtering, pagination, column chooser, and CSV export.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsup && tsc -p tsconfig.build.json",
    "test": "jest --passWithNoTests",
    "storybook": "ng run angular-primeng:storybook",
    "build-storybook": "ng run angular-primeng:build-storybook"
  },
  "keywords": [
    "ogrid",
    "angular",
    "primeng",
    "datatable",
    "typescript",
    "grid"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alaarab/ogrid-angular": "2.1.5"
  },
  "peerDependencies": {
    "@angular/core": "^21.0.0",
    "@angular/common": "^21.0.0",
    "primeng": "^21.0.0"
  },
  "devDependencies": {
    "@angular/core": "^21.1.4",
    "@angular/common": "^21.1.4",
    "@angular/compiler": "^21.1.4",
    "@angular/platform-browser": "^21.1.4",
    "@angular/platform-browser-dynamic": "^21.1.4",
    "@angular/animations": "^21.1.4",
    "@angular/router": "^21.1.4",
    "primeng": "^21.1.1",
    "rxjs": "^7.8.2",
    "zone.js": "^0.15.0",
    "typescript": "^5.9.3",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.4",
    "@angular-devkit/core": "^21.1.4",
    "@angular-devkit/architect": "^0.2101.4",
    "@angular-devkit/build-angular": "^21.1.4",
    "@storybook/angular": "^10.2.8",
    "storybook": "^10.2.8"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alaarab/ogrid.git",
    "directory": "packages/angular-primeng"
  },
  "homepage": "https://ogrid.dev",
  "bugs": "https://github.com/alaarab/ogrid/issues"
