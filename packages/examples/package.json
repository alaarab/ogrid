{
  "name": "@alaarab/ogrid-examples",
  "version": "2.9.1",
  "private": true,
  "description": "OGrid example apps for React and Vanilla JS UI packages.",
  "scripts": {
    "build": "npm run build:react-fluent && npm run build:react-material && npm run build:react-radix && npm run build:js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:react-fluent": "vite --config vite.fluent.config.ts",
    "dev:react-material": "vite --config vite.material.config.ts",
    "dev:react-radix": "vite --config vite.radix.config.ts",
    "dev:js": "vite --config vite.js.config.ts",
    "build:react-fluent": "vite build --config vite.fluent.config.ts",
    "build:react-material": "vite build --config vite.material.config.ts",
    "build:react-radix": "vite build --config vite.radix.config.ts",
    "build:js": "vite build --config vite.js.config.ts"
  },
  "dependencies": {
    "@alaarab/ogrid-core": "2.9.1",
    "@alaarab/ogrid-js": "2.9.1",
    "@alaarab/ogrid-js-inputs": "2.9.1",
    "@alaarab/ogrid-mcp": "2.9.1",
    "@alaarab/ogrid-react": "2.9.1",
    "@alaarab/ogrid-react-fluent": "2.9.1",
    "@alaarab/ogrid-react-inputs": "2.9.1",
    "@alaarab/ogrid-react-material": "2.9.1",
    "@alaarab/ogrid-react-radix": "2.9.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fluentui/react-components": "^9.73.8",
    "@fluentui/react-icons": "^2.0.325",
    "@mui/icons-material": "^7.3.10",
    "@mui/material": "^7.3.10",
    "@mui/x-data-grid": "^8.28.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-popover": "^1.1.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.10"
  }
}
