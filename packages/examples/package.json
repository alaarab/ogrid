{
  "name": "@alaarab/ogrid-examples",
  "version": "2.14.2",
  "private": true,
  "description": "OGrid example apps for the React UI packages.",
  "scripts": {
    "build": "npm run build:react-fluent && npm run build:react-radix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:react-fluent": "vite --config vite.fluent.config.ts",
    "dev:react-radix": "vite --config vite.radix.config.ts",
    "build:react-fluent": "vite build --config vite.fluent.config.ts",
    "build:react-radix": "vite build --config vite.radix.config.ts"
  },
  "dependencies": {
    "@alaarab/ogrid-core": "2.14.2",
    "@alaarab/ogrid-mcp": "2.14.2",
    "@alaarab/ogrid-react": "2.14.2",
    "@alaarab/ogrid-react-fluent": "2.14.2",
    "@alaarab/ogrid-react-inputs": "2.14.2",
    "@alaarab/ogrid-react-radix": "2.14.2",
    "@fluentui/react-components": "^9.73.8",
    "@fluentui/react-icons": "^2.0.325",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-popover": "^1.1.15",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "vite": "^8.0.10"
  }
}
