{
  "name": "@alaarab/ogrid-examples",
  "version": "2.17.0",
  "private": true,
  "description": "OGrid example apps for the React UI packages.",
  "scripts": {
    "build": "npm run build:react-fluent && npm run build:react-radix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev:react-fluent": "vite --config vite.fluent.config.ts",
    "dev:react-radix": "vite --config vite.radix.config.ts",
    "build:react-fluent": "vite build --config vite.fluent.config.ts",
    "build:react-radix": "vite build --config vite.radix.config.ts"
  },
  "dependencies": {
    "@alaarab/ogrid-core": "2.17.0",
    "@alaarab/ogrid-mcp": "2.17.0",
    "@alaarab/ogrid-react": "2.17.0",
    "@alaarab/ogrid-react-fluent": "2.17.0",
    "@alaarab/ogrid-react-inputs": "2.17.0",
    "@alaarab/ogrid-react-radix": "2.17.0",
    "@alaarab/ogrid-react-xlsx": "2.17.0",
    "@fluentui/react-components": "^9.74.7",
    "@fluentui/react-icons": "^2.0.339",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-popover": "^1.1.23",
    "exceljs": "^4.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "vite": "^8.2.2"
  },
  "type": "module"
}
