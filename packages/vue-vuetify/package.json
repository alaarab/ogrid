{
  "name": "@alaarab/ogrid-vue-vuetify",
  "version": "2.0.22",
  "description": "OGrid Vuetify – Vuetify-based data grid with sorting, filtering, pagination, column chooser, and CSV export.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json && node scripts/copy-css.js",
    "test": "jest --passWithNoTests",
    "storybook": "storybook dev -p 6011 --no-open",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "ogrid",
    "vue",
    "vuetify",
    "datatable",
    "typescript",
    "grid"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alaarab/ogrid-vue": "2.0.22"
  },
  "peerDependencies": {
    "vue": "^3.3.0",
    "vuetify": "^3.0.0"
  },
  "devDependencies": {
    "@mdi/font": "^7.4.47",
    "@storybook/vue3-vite": "^10.2.8",
    "@vitejs/plugin-vue": "^6.0.4",
    "storybook": "^10.2.8",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.28",
    "vuetify": "^3.11.8"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  }
}
