{
  "name": "@alaarab/ogrid-react",
  "version": "2.10.0",
  "description": "OGrid React – React hooks, headless components, and utilities for OGrid data grids.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./testing": {
      "types": "./src/testing/index.d.ts",
      "import": "./dist/esm/testing/index.js",
      "default": "./dist/esm/testing/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsup && tsc -p tsconfig.build.json",
    "test": "jest"
  },
  "keywords": [
    "ogrid",
    "datatable",
    "react",
    "typescript",
    "grid",
    "core"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "src/testing/index.d.ts",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alaarab/ogrid-core": "2.10.0",
    "@tanstack/react-virtual": "^3.13.24"
  },
  "peerDependencies": {
    "@testing-library/react": "^16.0.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alaarab/ogrid.git",
    "directory": "packages/react"
  },
  "homepage": "https://ogrid.dev",
  "bugs": "https://github.com/alaarab/ogrid/issues"
}
