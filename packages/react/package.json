{
  "name": "@alaarab/ogrid-react",
  "version": "2.18.0",
  "type": "module",
  "description": "OGrid React \u2013 React hooks, headless components, and utilities for OGrid data grids.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "typesVersions": {
    "*": {
      "testing": [
        "dist/types/testing/index.d.ts"
      ],
      "data-validation": [
        "dist/types/components/DataValidationForm.d.ts"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./testing": {
      "types": "./dist/types/testing/index.d.ts",
      "import": "./dist/esm/testing/index.js",
      "default": "./dist/esm/testing/index.js"
    },
    "./data-validation": {
      "types": "./dist/types/components/DataValidationForm.d.ts",
      "import": "./dist/esm/data-validation.js",
      "default": "./dist/esm/data-validation.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsup && tsc -p tsconfig.build.json && tsc -p tsconfig.testing.build.json && node ../../scripts/fix-dts-extensions.mjs dist/types && node ../../scripts/add-use-client.mjs dist/esm/index.js && node ../../scripts/add-use-client.mjs dist/esm/data-validation.js",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "test": "bun test --preload ../../bun-test.setup.ts"
  },
  "keywords": [
    "ogrid",
    "datatable",
    "react",
    "typescript",
    "grid",
    "core"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alaarab/ogrid-core": "2.18.0",
    "@tanstack/react-virtual": "^3.14.13"
  },
  "peerDependencies": {
    "@testing-library/react": "^16.3.3",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@testing-library/react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alaarab/ogrid.git",
    "directory": "packages/react"
  },
  "homepage": "https://ogrid.dev",
  "bugs": "https://github.com/alaarab/ogrid/issues"
}
