{
  "name": "@alaarab/ogrid-vue-primevue",
  "version": "2.7.3",
  "description": "OGrid PrimeVue – PrimeVue-based data grid with sorting, filtering, pagination, column chooser, and CSV export.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./styles/*": "./dist/esm/*"
  },
  "scripts": {
    "build": "rimraf dist && tsup && tsc -p tsconfig.build.json",
    "test": "jest",
    "storybook": "storybook dev -p 6013 --no-open",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "ogrid",
    "vue",
    "primevue",
    "datatable",
    "typescript",
    "grid"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alaarab/ogrid-vue": "2.7.3"
  },
  "peerDependencies": {
    "primevue": "^4.0.0",
    "vue": "^3.3.0"
  },
  "devDependencies": {
    "@storybook/vue3-vite": "^10.3.3",
    "@vitejs/plugin-vue": "^6.0.5",
    "primeicons": "^7.0.0",
    "primevue": "^4.5.4",
    "storybook": "^10.3.3",
    "typescript": "^6.0.0",
    "vite": "^8.0.5",
    "vite-plugin-dts": "^4.5.4",
    "vue": "^3.5.28"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alaarab/ogrid.git",
    "directory": "packages/vue-primevue"
  },
  "homepage": "https://ogrid.dev",
  "bugs": "https://github.com/alaarab/ogrid/issues"
}
