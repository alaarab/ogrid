{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declarationDir": "dist/types",
    "outDir": "dist/esm",
    "rootDir": "src",
    "jsx": "react-jsx",
    "paths": {
      "@alaarab/ogrid-core": [
        "../core/src/index.ts"
      ],
      "@alaarab/ogrid-core/formula": [
        "../core/src/formula/index.ts"
      ],
      "@alaarab/ogrid-react": [
        "../react/src/index.ts"
      ],
      "@alaarab/ogrid-react/testing": [
        "../react/src/testing/index.ts"
      ],
      "@alaarab/ogrid-react/storybook": [
        "../react/src/storybook/index.ts"
      ]
    },
    "noUncheckedIndexedAccess": true
  },
  "include": [
    "src"
  ],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.stories.tsx",
    "src/**/*.module.scss.ts"
  ]
}
