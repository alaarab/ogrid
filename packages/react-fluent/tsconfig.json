{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "declaration": true,
    "declarationDir": "dist/types",
    "outDir": "dist/esm",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"],
    "rootDir": "src",
    "paths": {
      "@alaarab/ogrid-core": ["../core/src/index.ts"],
      "@alaarab/ogrid-core/formula": ["../core/src/formula/index.ts"],
      "@alaarab/ogrid-react": ["../react/src/index.ts"],
      "@alaarab/ogrid-react/testing": ["../react/src/testing/index.ts"],
      "@alaarab/ogrid-react/storybook": ["../react/src/storybook/index.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/**/__tests__/**",
    "src/**/*.stories.tsx",
    "src/**/*.module.scss.ts"
  ]
}
