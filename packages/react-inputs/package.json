{
  "name": "@alaarab/ogrid-react-inputs",
  "version": "2.5.5",
  "description": "OGrid React Inputs – Optional premium cell editors (DatePicker, and more). Zero impact when not installed.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
