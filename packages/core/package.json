{
  "name": "@alaarab/ogrid-core",
  "version": "2.13.0",
  "description": "OGrid core – framework-agnostic types, algorithms, and utilities for OGrid data grids.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./formula": {
      "types": "./dist/types/formula/index.d.ts",
      "import": "./dist/esm/formula/index.js",
      "default": "./dist/esm/formula/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsup && tsc -p tsconfig.build.json",
    "test": "bun test --preload ../../bun-test.setup.ts"
  },
  "keywords": [
    "ogrid",
    "datatable",
    "typescript",
    "grid",
    "core"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alaarab/ogrid.git",
    "directory": "packages/core"
  },
  "homepage": "https://ogrid.dev",
  "bugs": "https://github.com/alaarab/ogrid/issues"
}
