{
  "name": "@alaarab/ogrid-angular-material",
  "version": "2.0.15",
  "description": "OGrid Angular Material – MatTable-based data grid with sorting, filtering, pagination, column chooser, and CSV export.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "test": "jest --passWithNoTests",
    "storybook": "ng run angular-material:storybook",
    "build-storybook": "ng run angular-material:build-storybook"
  },
  "keywords": [
    "ogrid",
    "angular",
    "material",
    "datatable",
    "typescript",
    "grid"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alaarab/ogrid-angular": "2.0.15"
  },
  "peerDependencies": {
    "@angular/cdk": "^21.0.0",
    "@angular/common": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/material": "^21.0.0"
  },
  "devDependencies": {
    "@angular/animations": "^21.1.4",
    "@angular/cdk": "^21.1.4",
    "@angular/common": "^21.1.4",
    "@angular/compiler": "^21.1.4",
    "@angular/core": "^21.1.4",
    "@angular/material": "^21.1.4",
    "@angular/platform-browser": "^21.1.4",
    "@angular/platform-browser-dynamic": "^21.1.4",
    "rxjs": "^7.8.2",
    "typescript": "^5.9.3",
    "zone.js": "^0.15.0",
    "@angular/cli": "^21.1.4",
    "@angular/compiler-cli": "^21.1.4",
    "@angular-devkit/core": "^21.1.4",
    "@angular-devkit/architect": "^0.2101.4",
    "@angular-devkit/build-angular": "^21.1.4",
    "@storybook/angular": "^10.2.8",
    "storybook": "^10.2.8"
  },
  "sideEffects": false,
  "publishConfig": {
    "access": "public"
  }
}
