{
  "name": "@alaarab/ogrid-mcp",
  "version": "2.17.0",
  "description": "MCP server for OGrid documentation",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/alaarab/ogrid.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "ogrid-mcp": "./dist/esm/index.js"
  },
  "main": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    },
    "./bridge-client": {
      "import": "./dist/esm/bridge-client.js",
      "default": "./dist/esm/bridge-client.js"
    }
  },
  "files": [
    "dist",
    "bundled-docs"
  ],
  "scripts": {
    "prebuild": "node scripts/bundle-docs.mjs",
    "build": "tsup && tsc -p tsconfig.json --emitDeclarationOnly --outDir dist/esm",
    "dev": "tsup --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test --preload ../../bun-test.setup.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  }
}
