{
  "name": "@alaarab/ogrid-react-xlsx-browser",
  "version": "2.19.1",
  "type": "module",
  "description": "Self-contained browser ESM bundle of @alaarab/ogrid-react-xlsx. React + ReactDOM + ExcelJS + every @alaarab/ogrid-* dep included with local lazy chunks. Copy dist/ into a static vendor/ directory and `import()` from a no-bundler app.",
  "main": "dist/ogrid-xlsx.js",
  "module": "dist/ogrid-xlsx.js",
  "types": "dist/ogrid-xlsx.d.ts",
  "exports": {
    ".": {
      "types": "./dist/ogrid-xlsx.d.ts",
      "import": "./dist/ogrid-xlsx.js",
      "default": "./dist/ogrid-xlsx.js"
    },
    "./ogrid-xlsx.css": "./dist/ogrid-xlsx.css"
  },
  "scripts": {
    "build": "rimraf dist && tsup && node scripts/copy-types.mjs",
    "test:runtime": "node ../../scripts/test-browser-bundle.mjs"
  },
  "keywords": [
    "ogrid",
    "xlsx",
    "excel",
    "spreadsheet",
    "browser",
    "no-bundler",
    "esm",
    "vendor"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "engines": {
    "node": ">=18"
  },
  "peerDependencies": {
    "@alaarab/ogrid-core": "2.19.1",
    "exceljs": "^4.4.0",
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@alaarab/ogrid-core": {
      "optional": true
    },
    "exceljs": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@alaarab/ogrid-react-xlsx": "2.19.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alaarab/ogrid.git",
    "directory": "packages/react-xlsx-browser"
  },
  "homepage": "https://ogrid.dev",
  "bugs": "https://github.com/alaarab/ogrid/issues"
}
