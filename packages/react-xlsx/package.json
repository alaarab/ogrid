{
  "name": "@alaarab/ogrid-react-xlsx",
  "version": "2.11.1",
  "description": "Drop an xlsx Blob, get a fully featured OGrid. Wraps SheetJS + @alaarab/ogrid-react-radix with formula engine + Excel cell references on by default.",
  "main": "dist/esm/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "scripts": {
    "build": "rimraf dist && tsup && tsc -p tsconfig.build.json",
    "test": "bun test --preload ../../bun-test.setup.ts"
  },
  "keywords": [
    "ogrid",
    "xlsx",
    "excel",
    "spreadsheet",
    "sheetjs",
    "react",
    "datatable",
    "grid"
  ],
  "author": "Ala Arab",
  "license": "MIT",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@alaarab/ogrid-core": "2.11.1",
    "@alaarab/ogrid-react": "2.11.1",
    "@alaarab/ogrid-react-radix": "2.11.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "peerDependencies": {
    "react": "^17.0.0 || ^18.0.0 || ^19.0.0",
    "react-dom": "^17.0.0 || ^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "rimraf": "^6.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.7.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/alaarab/ogrid.git",
    "directory": "packages/react-xlsx"
  },
  "homepage": "https://ogrid.dev",
  "bugs": "https://github.com/alaarab/ogrid/issues"
}
