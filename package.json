{
  "name": "ogrid",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/inputs",
    "packages/react",
    "packages/react-radix",
    "packages/react-fluent",
    "packages/react-inputs",
    "packages/react-xlsx",
    "packages/react-xlsx-browser",
    "packages/mcp",
    "packages/docs",
    "packages/examples"
  ],
  "scripts": {
    "build": "turbo build",
    "build:examples": "turbo build --filter=@alaarab/ogrid-examples",
    "build:react-family": "turbo build --filter=@alaarab/ogrid-react --filter=@alaarab/ogrid-react-radix --filter=@alaarab/ogrid-react-fluent",
    "typecheck": "turbo typecheck",
    "test": "bun run --filter '*' test",
    "test:all": "bun run --filter '*' test",
    "test:coverage": "bun run --filter '*' test -- --coverage",
    "test:core": "bun --filter '@alaarab/ogrid-core' test",
    "test:react": "bun --filter '@alaarab/ogrid-react' test",
    "test:react-family": "turbo test --filter=@alaarab/ogrid-react --filter=@alaarab/ogrid-react-radix --filter=@alaarab/ogrid-react-fluent",
    "test:fluent": "bun --filter '@alaarab/ogrid-react-fluent' test",
    "test:radix": "bun --filter '@alaarab/ogrid-react-radix' test",
    "test:inputs": "bun --filter '@alaarab/ogrid-inputs' test",
    "test:react-inputs": "bun --filter '@alaarab/ogrid-react-inputs' test",
    "test:mcp": "bun --filter '@alaarab/ogrid-mcp' test",
    "test:examples:types": "bun --filter '@alaarab/ogrid-examples' typecheck",
    "dev:react-fluent": "bun --filter '@alaarab/ogrid-examples' dev:react-fluent",
    "dev:react-radix": "bun --filter '@alaarab/ogrid-examples' dev:react-radix",
    "serve:e2e:react-fluent": "bun --filter '@alaarab/ogrid-examples' serve:e2e:react-fluent",
    "serve:e2e:react-radix": "bun --filter '@alaarab/ogrid-examples' serve:e2e:react-radix",
    "storybook:react-fluent": "bun --filter '@alaarab/ogrid-react-fluent' storybook",
    "storybook:react-radix": "bun --filter '@alaarab/ogrid-react-radix' storybook",
    "docs:dev": "bun --filter '@alaarab/ogrid-docs' start",
    "docs:dev:full": "turbo build --filter=@alaarab/ogrid-react-radix --filter=@alaarab/ogrid-react-fluent --filter=@alaarab/ogrid-react-inputs && bun --filter '@alaarab/ogrid-docs' start",
    "docs:build": "bun --filter '@alaarab/ogrid-docs' build",
    "docs:serve": "bun --filter '@alaarab/ogrid-docs' serve",
    "test:fast": "bun run --filter '*' test",
    "size": "size-limit",
    "check:types": "node scripts/check-package-types.mjs",
    "check:exports": "node scripts/check-public-exports.mjs",
    "check:versions": "bun scripts/check-versions.mjs",
    "test:browser-bundle": "node scripts/test-browser-bundle.mjs",
    "test:react-compat": "node scripts/test-react-compat.mjs",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "test:e2e": "node scripts/run-playwright-matrix.mjs",
    "test:e2e:docs": "bunx playwright test --config=playwright.docs.config.ts",
    "test:e2e:smoke": "bunx playwright test --config=playwright.smoke.config.ts",
    "test:e2e:matrix": "bun scripts/run-playwright-matrix.mjs",
    "audit:visual": "OGRID_VISUAL_AUDIT=1 bunx playwright test e2e/visualAudit.spec.ts",
    "test:e2e:react": "bunx playwright test --project=react-radix",
    "publish:all": "node scripts/publish-all.mjs",
    "version:bump": "bun scripts/version-bump.mjs",
    "bench": "bunx tsx packages/core/src/__benchmarks__/performance.bench.ts",
    "mcp": "bun packages/mcp/dist/esm/index.js",
    "prepare": "husky"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.19.0",
    "bun": ">=1.4.2"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@biomejs/biome": "^2.5.15",
    "@happy-dom/global-registrator": "^20.14.5",
    "@playwright/test": "^1.63.0",
    "@radix-ui/react-checkbox": "^1.3.11",
    "@radix-ui/react-popover": "^1.1.23",
    "@size-limit/esbuild": "^14.1.0",
    "@size-limit/file": "^14.1.0",
    "@tanstack/react-virtual": "^3.14.13",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^26.6.4",
    "esbuild-sass-plugin": "^3.7.0",
    "happy-dom": "^20.14.5",
    "husky": "^9.1.7",
    "jest-axe": "^11.0.0",
    "lint-staged": "^17.6.0",
    "postcss-modules": "^9.0.1",
    "rimraf": "^6.1.3",
    "size-limit": "^14.1.0",
    "tsup": "^8.5.1",
    "turbo": "^2.11.7",
    "typescript": "^7.0.2"
  },
  "version": "2.19.1",
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "picomatch": "^4.0.7",
    "serialize-javascript": "^7.1.2",
    "vite": "^8.3.2",
    "brace-expansion": "^5.0.12",
    "dompurify": "^3.4.16",
    "fast-uri": "^4.2.1",
    "qs": "^6.16.0",
    "tmp": "^0.2.7",
    "ip-address": "^10.7.3",
    "ws": "^8.22.0",
    "uuid": "^14.0.2",
    "webpack-dev-server": "^6.0.0",
    "hono": "^4.13.13",
    "mermaid": "^12.1.0",
    "esbuild": "^0.28.2",
    "tinypool": "2.1.2",
    "postcss-selector-parser": "7.1.6",
    "katex": "0.18.11"
  }
}
