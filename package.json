{
  "name": "ogrid",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "npm run test --workspaces --if-present",
    "test:all": "npm run test --workspaces --if-present",
    "test:core": "npm test -w @alaarab/ogrid-core",
    "test:js": "npm test -w @alaarab/ogrid-js",
    "test:react": "npm test -w @alaarab/ogrid-react",
    "test:fluent": "npm test -w @alaarab/ogrid-react-fluent",
    "test:material": "npm test -w @alaarab/ogrid-react-material",
    "test:radix": "npm test -w @alaarab/ogrid-react-radix",
    "storybook:fluent": "npm run storybook -w @alaarab/ogrid-react-fluent",
    "storybook:material": "npm run storybook -w @alaarab/ogrid-react-material",
    "storybook:radix": "npm run storybook -w @alaarab/ogrid-react-radix",
    "docs:dev": "npm run start -w @alaarab/ogrid-docs",
    "docs:dev:full": "npm run build -w @alaarab/ogrid-core && npm run build -w @alaarab/ogrid-react && npm run build -w @alaarab/ogrid-react-radix && npm run start -w @alaarab/ogrid-docs",
    "docs:build": "npm run build -w @alaarab/ogrid-docs",
    "docs:serve": "npm run serve -w @alaarab/ogrid-docs",
    "lint": "eslint .",
    "publish:all": "npm publish --workspace=packages/core --access=public && npm publish --workspace=packages/react --access=public && npm publish --workspace=packages/js --access=public && npm publish --workspace=packages/react-fluent --access=public && npm publish --workspace=packages/react-material --access=public && npm publish --workspace=packages/react-radix --access=public"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@types/jest": "^29.5.14",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.2.5",
    "turbo": "^2.8.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.15.0"
  },
  "version": "2.0.0-beta"
}
