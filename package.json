{
  "name": "ogrid",
  "private": true,
  "workspaces": [
    "packages/core",
    "packages/inputs",
    "packages/react",
    "packages/react-radix",
    "packages/react-fluent",
    "packages/react-material",
    "packages/react-inputs",
    "packages/js",
    "packages/js-inputs",
    "packages/mcp",
    "packages/docs",
    "packages/examples"
  ],
  "scripts": {
    "build": "turbo build",
    "build:examples": "turbo build --filter=@alaarab/ogrid-examples",
    "build:react-family": "turbo build --filter=@alaarab/ogrid-react --filter=@alaarab/ogrid-react-radix --filter=@alaarab/ogrid-react-fluent --filter=@alaarab/ogrid-react-material",
    "test": "npm --workspaces --if-present run test",
    "test:all": "npm --workspaces --if-present run test",
    "test:coverage": "npm --workspaces --if-present run test -- --coverage",
    "test:core": "npm test -w @alaarab/ogrid-core",
    "test:js": "npm test -w @alaarab/ogrid-js",
    "test:react": "npm test -w @alaarab/ogrid-react",
    "test:react-family": "turbo test --filter=@alaarab/ogrid-react --filter=@alaarab/ogrid-react-radix --filter=@alaarab/ogrid-react-fluent --filter=@alaarab/ogrid-react-material",
    "test:fluent": "npm test -w @alaarab/ogrid-react-fluent",
    "test:material": "npm test -w @alaarab/ogrid-react-material",
    "test:radix": "npm test -w @alaarab/ogrid-react-radix",
    "test:inputs": "npm test -w @alaarab/ogrid-inputs",
    "test:react-inputs": "npm test -w @alaarab/ogrid-react-inputs",
    "test:js-inputs": "npm test -w @alaarab/ogrid-js-inputs",
    "test:mcp": "npm test -w @alaarab/ogrid-mcp",
    "test:examples:types": "npm run typecheck -w @alaarab/ogrid-examples",
    "dev:react-fluent": "npm run dev:react-fluent -w @alaarab/ogrid-examples",
    "dev:react-material": "npm run dev:react-material -w @alaarab/ogrid-examples",
    "dev:react-radix": "npm run dev:react-radix -w @alaarab/ogrid-examples",
    "dev:js": "npm run dev:js -w @alaarab/ogrid-examples",
    "storybook:react-fluent": "npm run storybook -w @alaarab/ogrid-react-fluent",
    "storybook:react-material": "npm run storybook -w @alaarab/ogrid-react-material",
    "storybook:react-radix": "npm run storybook -w @alaarab/ogrid-react-radix",
    "docs:dev": "npm run start -w @alaarab/ogrid-docs",
    "docs:dev:full": "npm run build -w @alaarab/ogrid-core && npm run build -w @alaarab/ogrid-react && npm run build -w @alaarab/ogrid-react-radix && npm run start -w @alaarab/ogrid-docs",
    "docs:build": "npm run build -w @alaarab/ogrid-docs",
    "docs:serve": "npm run serve -w @alaarab/ogrid-docs",
    "test:fast": "npm --workspaces --if-present run test",
    "size": "size-limit",
    "lint": "biome check .",
    "lint:fix": "biome check --fix .",
    "test:e2e": "node scripts/run-playwright-matrix.mjs",
    "test:e2e:docs": "npx playwright test --config=playwright.docs.config.ts",
    "test:e2e:smoke": "npx playwright test --config=playwright.smoke.config.ts",
    "test:e2e:matrix": "node scripts/run-playwright-matrix.mjs",
    "audit:visual": "OGRID_VISUAL_AUDIT=1 npx playwright test e2e/visualAudit.spec.ts",
    "test:e2e:react": "npx playwright test --project=react-radix",
    "test:e2e:js": "npx playwright test --project=js",
    "publish:all": "npm publish --workspace=packages/core --access=public && npm publish --workspace=packages/react --access=public && npm publish --workspace=packages/js --access=public && npm publish --workspace=packages/react-fluent --access=public && npm publish --workspace=packages/react-material --access=public && npm publish --workspace=packages/react-radix --access=public && npm publish --workspace=packages/inputs --access=public && npm publish --workspace=packages/react-inputs --access=public && npm publish --workspace=packages/js-inputs --access=public && npm publish --workspace=packages/mcp --access=public",
    "version:bump": "node scripts/version-bump.mjs",
    "sync:theme": "node scripts/sync-theme.mjs",
    "sync:theme:check": "node scripts/sync-theme.mjs --check",
    "bench": "npx tsx packages/core/src/__benchmarks__/performance.bench.ts",
    "mcp": "node packages/mcp/dist/esm/index.js",
    "prepare": "husky"
  },
  "packageManager": "npm@11.13.0",
  "engines": {
    "node": ">=18",
    "npm": ">=10"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@playwright/test": "^1.59.1",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@size-limit/preset-small-lib": "^12.1.0",
    "@tanstack/react-virtual": "^3.13.24",
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.6.0",
    "esbuild-sass-plugin": "^3.7.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.3.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.3.0",
    "lint-staged": "^16.4.0",
    "postcss-modules": "^6.0.1",
    "rimraf": "^6.1.3",
    "size-limit": "^12.1.0",
    "ts-jest": "^29.4.9",
    "tsup": "^8.5.1",
    "turbo": "^2.9.8",
    "typescript": "^6.0.3"
  },
  "version": "2.9.1",
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --fix --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "picomatch": "^4.0.4",
    "serialize-javascript": "^7.0.5",
    "vite": "^8.0.0"
  }
}
