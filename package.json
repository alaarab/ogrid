{
  "name": "ogrid",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "test": "npm --workspaces --if-present run test",
    "test:all": "npm --workspaces --if-present run test",
    "test:core": "npm test -w @alaarab/ogrid-core",
    "test:js": "npm test -w @alaarab/ogrid-js",
    "test:react": "npm test -w @alaarab/ogrid-react",
    "test:fluent": "npm test -w @alaarab/ogrid-react-fluent",
    "test:material": "npm test -w @alaarab/ogrid-react-material",
    "test:radix": "npm test -w @alaarab/ogrid-react-radix",
    "test:angular": "npm test -w @alaarab/ogrid-angular",
    "test:angular-material": "npm test -w @alaarab/ogrid-angular-material",
    "test:angular-primeng": "npm test -w @alaarab/ogrid-angular-primeng",
    "test:vue": "npm test -w @alaarab/ogrid-vue",
    "test:vue-vuetify": "npm test -w @alaarab/ogrid-vue-vuetify",
    "test:vue-primevue": "npm test -w @alaarab/ogrid-vue-primevue",
    "test:angular-radix": "npm test -w @alaarab/ogrid-angular-radix",
    "test:vue-radix": "npm test -w @alaarab/ogrid-vue-radix",
    "test:inputs": "npm test -w @alaarab/ogrid-inputs",
    "test:react-inputs": "npm test -w @alaarab/ogrid-react-inputs",
    "test:angular-inputs": "npm test -w @alaarab/ogrid-angular-inputs",
    "test:vue-inputs": "npm test -w @alaarab/ogrid-vue-inputs",
    "test:js-inputs": "npm test -w @alaarab/ogrid-js-inputs",
    "dev:react-fluent": "npm run dev:react-fluent -w @alaarab/ogrid-examples",
    "dev:react-material": "npm run dev:react-material -w @alaarab/ogrid-examples",
    "dev:react-radix": "npm run dev:react-radix -w @alaarab/ogrid-examples",
    "dev:angular-material": "npm run dev:angular-material -w @alaarab/ogrid-examples",
    "dev:angular-primeng": "npm run dev:angular-primeng -w @alaarab/ogrid-examples",
    "dev:angular-radix": "npm run dev:angular-radix -w @alaarab/ogrid-examples",
    "dev:vue-vuetify": "npm run dev:vue-vuetify -w @alaarab/ogrid-examples",
    "dev:vue-primevue": "npm run dev:vue-primevue -w @alaarab/ogrid-examples",
    "dev:vue-radix": "npm run dev:vue-radix -w @alaarab/ogrid-examples",
    "dev:js": "npm run dev:js -w @alaarab/ogrid-examples",
    "storybook:react-fluent": "npm run storybook -w @alaarab/ogrid-react-fluent",
    "storybook:react-material": "npm run storybook -w @alaarab/ogrid-react-material",
    "storybook:react-radix": "npm run storybook -w @alaarab/ogrid-react-radix",
    "storybook:angular-material": "npm run storybook -w @alaarab/ogrid-angular-material",
    "storybook:angular-primeng": "npm run storybook -w @alaarab/ogrid-angular-primeng",
    "storybook:angular-radix": "npm run storybook -w @alaarab/ogrid-angular-radix",
    "storybook:vue-vuetify": "npm run storybook -w @alaarab/ogrid-vue-vuetify",
    "storybook:vue-primevue": "npm run storybook -w @alaarab/ogrid-vue-primevue",
    "storybook:vue-radix": "npm run storybook -w @alaarab/ogrid-vue-radix",
    "docs:dev": "npm run start -w @alaarab/ogrid-docs",
    "docs:dev:full": "npm run build -w @alaarab/ogrid-core && npm run build -w @alaarab/ogrid-react && npm run build -w @alaarab/ogrid-react-radix && npm run start -w @alaarab/ogrid-docs",
    "docs:build": "npm run build -w @alaarab/ogrid-docs",
    "docs:serve": "npm run serve -w @alaarab/ogrid-docs",
    "test:fast": "npm --workspaces --if-present run test",
    "size": "size-limit",
    "lint": "eslint .",
    "test:e2e": "npx playwright test",
    "test:e2e:react": "npx playwright test --project=react-radix",
    "test:e2e:angular": "npx playwright test --project=angular-material",
    "test:e2e:vue": "npx playwright test --project=vue-vuetify",
    "test:e2e:js": "npx playwright test --project=js",
    "publish:all": "npm publish --workspace=packages/core --access=public && npm publish --workspace=packages/react --access=public && npm publish --workspace=packages/js --access=public && npm publish --workspace=packages/react-fluent --access=public && npm publish --workspace=packages/react-material --access=public && npm publish --workspace=packages/react-radix --access=public && npm publish --workspace=packages/angular --access=public && npm publish --workspace=packages/angular-material --access=public && npm publish --workspace=packages/angular-primeng --access=public && npm publish --workspace=packages/angular-radix --access=public && npm publish --workspace=packages/vue --access=public && npm publish --workspace=packages/vue-vuetify --access=public && npm publish --workspace=packages/vue-primevue --access=public && npm publish --workspace=packages/vue-radix --access=public",
    "version:bump": "npm version --workspaces --include-workspace-root --no-git-tag-version",
    "bench": "npx tsx packages/core/src/__benchmarks__/performance.bench.ts",
    "mcp": "node packages/mcp/dist/esm/index.js",
    "prepare": "husky"
  },
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=18",
    "npm": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@playwright/test": "^1.58.2",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@size-limit/preset-small-lib": "^12.0.0",
    "@tanstack/react-virtual": "^3.13.18",
    "@testing-library/dom": "^10.4.1",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^25.3.0",
    "esbuild-sass-plugin": "^3.6.0",
    "eslint": "^9.15.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.0.0",
    "husky": "^9.1.7",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^30.2.0",
    "jest-axe": "^10.0.0",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^16.2.7",
    "postcss-modules": "^6.0.1",
    "rimraf": "^6.1.3",
    "size-limit": "^12.0.0",
    "ts-jest": "^29.4.6",
    "tsup": "^8.5.1",
    "turbo": "^2.8.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0"
  },
  "version": "2.5.7",
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix"
    ]
  },
  "overrides": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0"
  }
}
