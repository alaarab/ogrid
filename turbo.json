{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["src/**/*.ts", "src/**/*.tsx", "src/**/*.scss", "package.json", "tsconfig*.json"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "cache": true,
      "inputs": ["src/**", "tsconfig*.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "cache": true,
      "inputs": ["src/**", "$TURBO_ROOT$/bun-test.setup.ts", "tsconfig.*"],
      "outputs": ["coverage/**"]
    },
    "lint": {
      "cache": true
    },
    "storybook": {
      "cache": true,
      "inputs": ["src/**/*.stories.tsx", "src/**/*.stories.ts", "src/**/*.tsx", "src/**/*.ts", "src/**/*.scss", ".storybook/**"],
      "persistent": true
    }
  }
}
